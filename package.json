{
  "name": "rental-log-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm run dev -w @rental-log/web",
    "dev:api": "npm run dev -w @rental-log/api",
    "build": "npm run build -w @rental-log/web",
    "build:web": "npm run build -w @rental-log/web",
    "start": "npm run start -w @rental-log/api",
    "lint": "npm run lint -w @rental-log/web && npm run lint -w @rental-log/api",
    "test": "npm run test -w @rental-log/web && npm run test -w @rental-log/api",
    "clean": "rm -rf apps/web/dist"
  }
}
