{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@rental-log/database": ["./packages/database/src/index.ts"],
      "@rental-log/validation": ["./packages/validation/src/index.ts"],
      "@rental-log/auth": ["./packages/auth/src/index.ts"],
      "@rental-log/ui": ["./packages/ui/src/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src", "packages", "vite.config.ts"],
  "exclude": ["dist", "node_modules"]
}
