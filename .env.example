# ==============================================================================
# Kretz Real Estate Platform - Environment Configuration Blueprint (.env.example)
# ==============================================================================

# Server Environment & Port Configuration
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=https://kretzrealestate.com
ALLOWED_ORIGINS=https://kretzrealestate.com,https://app.kretzrealestate.com

# Administration & Security Credentials
ADMIN_EMAIL=admin@kretz.com
ADMIN_PASSWORD=your_secure_admin_password_here
SESSION_SECRET=your_super_secret_session_jwt_key_here
ADMIN_LOG_API_KEY=your_admin_log_api_key_here

# Cloudflare Turnstile Bot Defense
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
SKIP_TURNSTILE=false

# Smartsupp Live Chat Customer Desk
VITE_SMARTSUPP_KEY=61033062bd34d55a58c3546d5b618ead716fb2a3

# Institutional Email Delivery (Resend / SendGrid / Custom SMTP)
EMAIL_SENDER_NAME="L'Agence · Kretz"
EMAIL_FROM=info@kretzrealestate.com
EMAIL_REPLY_TO=support@kretzrealestate.com
EMAIL_SUPPORT=info@kretzrealestate.com
EMAIL_TEST_MODE=false

# Option A: Resend API
RESEND_API_KEY=re_123456789_your_resend_api_key

# Option B: SendGrid API
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Option C: Custom SMTP / Zoho / Gmail
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_USER=info@kretzrealestate.com
SMTP_PASS=your_smtp_app_password

# Translation API Keys
DEEPL_API_KEY=your_deepl_api_key_here
MYMEMORY_EMAIL=info@kretzrealestate.com
LIBRETRANSLATE_URL=https://translate.argosopentech.com/translate

# Solana Mainnet & Blockchain RPC Nodes
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Supabase Storage & Database Integration (Optional)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
