# Safe environment template for L'Agence / Rental.krez.
# Copy to a private local .env file. Never commit real credentials.
# Values below are placeholders; configure production secrets in Cloudflare.

PORT=3000
NODE_ENV=production
AUTH_SESSION_STORE=supabase
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://rental-krez.pages.dev,https://kretzdespain.com,https://www.kretzdespain.com

# Public frontend build configuration
VITE_API_BASE_URL=https://api.kretzdespain.com/api/v1
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY

# Server-side secrets: configure only in Cloudflare Worker encrypted secrets.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_LOG_API_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Transactional email: configure one provider only.
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_SENDER_NAME=
EMAIL_REPLY_TO=
EMAIL_SUPPORT=
EMAIL_TEST_MODE=false
PUBLIC_APP_URL=https://YOUR_FRONTEND_DOMAIN

# Optional legacy database settings. Supabase is the active persistence adapter.
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# Optional integrations
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DEPLOYER_PRIVATE_KEY=
SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SOLANA_SPL_TOKEN_PROGRAM=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
SOLANA_TOKEN_2022_PROGRAM=TokenzQdBNbLqP5VEhdKAS6EPFLC1PHnBqCXEPpxuEb
CAIXABANK_SEPA_GATEWAY_URL=
CAIXABANK_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
