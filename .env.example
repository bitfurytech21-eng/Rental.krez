# Environment Variables Template for L'Agence Real Estate Platform
# Copy this file to .env and populate with your environment credentials.
# DO NOT COMMIT REAL SECRETS OR PRIVATE KEYS TO REPOSITORY.

# Server Environment Configuration
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API Base URL (Frontend Client Configuration)
VITE_API_BASE_URL=/api/v1

# Admin Security Credentials Override (Optional)
ADMIN_CUSTOM_EMAIL=
ADMIN_CUSTOM_PASSWORD=
ADMIN_PASSPHRASE=

# Supabase (server-side API + browser authentication)
# SUPABASE_URL and SUPABASE_ANON_KEY are used to verify browser access tokens.
# SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY. Never prefix it with VITE_ or expose it to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional dedicated secret for the automated admin-log inspection endpoint.
# Leave unset to disable secret-based access; ordinary role-based admin access still works.
ADMIN_LOG_API_KEY=

# Frontend Supabase Auth (publishable/anon key only; safe for browser use)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Database / Cloud SQL Connection (legacy; Supabase is the active persistence adapter)
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=lagence_db

# JWT Authentication Secrets
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Blockchain & Solana Mainnet RPC Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DEPLOYER_PRIVATE_KEY=
SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SOLANA_SPL_TOKEN_PROGRAM=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
SOLANA_TOKEN_2022_PROGRAM=TokenzQdBNbLqP5VEhdKAS6EPFLC1PHnBqCXEPpxuEb

# Payment Gateways & Banking Integrations
CAIXABANK_SEPA_GATEWAY_URL=
CAIXABANK_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Identity & KYC / AML Verification
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=

# Email & SMS Communication Services
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
