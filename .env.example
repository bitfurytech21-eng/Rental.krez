# ============================================================================
# Kretz / L'Agence Real Estate Platform — Organized Environment Groups
# ============================================================================
# Safe template organized into 6 Environment Groups matching render.yaml.
# IMPORTANT:
#   - Never commit real production secrets to source control.
#   - Any variable prefixed with VITE_ is embedded at build time (`npm run build`).
#     Trigger a fresh build & deploy after updating any VITE_* variable.
#   - Leave unused optional secrets empty (do NOT paste fake placeholder strings).
# ============================================================================


# ============================================================================
# GROUP 1: kretz-core-runtime (Core Server & API Routing)
# ============================================================================
NODE_ENV=production
PORT=3000
VITE_API_BASE_URL=/api/v1


# ============================================================================
# GROUP 2: kretz-admin-security (Admin Gateway, Sessions & Audit Logs)
# ============================================================================
# Default active email if unset: admin@kretz.com
# Default active password if unset: AdminSecure2026!#
# Note: Setting a Custom Login at /admin/login overrides these automatically.
ADMIN_EMAIL=admin@kretz.com
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# 64-character random secrets for signing admin sessions & JWT verification
SESSION_SECRET=
JWT_SECRET=

# Internal API secrets for /api/v1/admin/logs & /api/v1/admin/logs/export
ADMIN_LOG_API_KEY=
ADMIN_LOG_API_SECRET=


# ============================================================================
# GROUP 3: kretz-supabase-client (Database & Investor Authentication)
# ============================================================================
# Build-time client keys from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=


# ============================================================================
# GROUP 4: kretz-cloudflare-turnstile (Human Verification & Bot Protection)
# ============================================================================
# Leave empty to use built-in fallback verification, or set your live pair
# from Cloudflare Dashboard -> Turnstile (Site Key = public, Secret = server)
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
SKIP_TURNSTILE=false


# ============================================================================
# GROUP 5: kretz-transactional-email (Configure ONE Provider Only)
# ============================================================================
# Priority 1 — Resend REST API (Recommended)
RESEND_API_KEY=

# Priority 2 — SendGrid Mail API v3
SENDGRID_API_KEY=

# Priority 3 — Custom SMTP Relay (Zoho Mail, Google Workspace, Amazon SES)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=


# ============================================================================
# GROUP 6: kretz-optional-integrations (Live Chat & Translation Engines)
# ============================================================================
# Customer live-chat widget (shown on public/investor pages only, never /admin)
VITE_SMARTSUPP_KEY=

# Multi-language translation engines (optional — falls back automatically)
DEEPL_API_KEY=
LIBRETRANSLATE_URL=https://translate.argosopentech.com/translate
LIBRETRANSLATE_API_KEY=
MYMEMORY_EMAIL=
