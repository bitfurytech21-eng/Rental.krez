# Port configuration for Node.js / Express server
PORT=3000
NODE_ENV=development

# Frontend API base URL (defaults to /api/v1 if not set)
VITE_API_BASE_URL=

# Supabase Auth & Database (Optional - app gracefully falls back to local ledger if unconfigured)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Server-Side Gemini API Key (Optional)
GEMINI_API_KEY=
