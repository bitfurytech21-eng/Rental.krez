# Environment Variables Template for L'Agence Real Estate Platform
# Copy this file to .env and populate with your environment credentials.
# DO NOT COMMIT REAL SECRETS OR PRIVATE KEYS TO REPOSITORY.

# Server Environment Configuration
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://rental-krez.pages.dev

# API Base URL (Frontend Client Configuration)
VITE_API_BASE_URL=/api/v1
# Production Pages builds use https://api.kretzdespain.com/api/v1 (configured in GitHub Actions).

# Admin Security Credentials Override (Optional; must match a provisioned user_roles record in production)
