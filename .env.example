# ============================================================================
# L'Agence / Kretz Prime Real Estate Platform - Environment Configuration
# ============================================================================
# Safe placeholder template. Do NOT commit real secrets to source control.
# Configure these variables in your deployment dashboard or secure secret manager.

# Server Port
PORT=3000
APP_PORT=3000

# Environment Mode ('development' | 'production' | 'test')
NODE_ENV=production

# ============================================================================
# 1. SECURE SERVER-SIDE ADMINISTRATOR AUTHENTICATION
# ============================================================================
# Authorized administrator email address
ADMIN_EMAIL=admin@example.com

# Secure bcrypt password hash (Recommended for production)
# Generate with: npx bcrypt-cli hash "YourPasswordHere" 10
ADMIN_PASSWORD_HASH=$2a$10$YourSecureBcryptHashPlaceholderHere

# Plaintext administrator password (Development fallback only - leave empty in production)
# ADMIN_PASSWORD=

# Cryptographic session secret used to sign session tokens and secure cookies
SESSION_SECRET=replace_with_a_64_character_cryptographically_secure_random_seed

# ============================================================================
# 2. INTERNAL SECURITY & AUDIT LOG API SECRETS
# ============================================================================
# Secrets used to authenticate administrative audit exports and internal log probes
ADMIN_LOG_API_KEY=replace_with_random_admin_log_api_key
ADMIN_LOG_API_SECRET=replace_with_random_admin_log_secret_key

# JWT Signing Secret (for Supabase or client JWT verification)
JWT_SECRET=replace_with_a_secure_jwt_secret_key

# Cloudflare Turnstile Bot Challenge (Optional)
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ============================================================================
# 3. TRANSACTIONAL EMAIL SYSTEM CONFIGURATION
# ============================================================================
# Priority 1: Resend REST API (Recommended for instant delivery)
RESEND_API_KEY=re_your_resend_api_key_placeholder

# Priority 2: SendGrid Mail API v3
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_placeholder

# Priority 3: SMTP Mail Relay (Zoho Mail, Google Workspace, Amazon SES, or custom)
# SMTP_HOST=smtppro.zoho.com
# SMTP_PORT=465
# SMTP_USER=info@example.com
# SMTP_PASS=your_secure_smtp_app_password
# SMTP_FROM=info@example.com

# Sandbox Simulation Mode (set to 'false' in production)
EMAIL_TEST_MODE=false

# ============================================================================
# 4. OPTIONAL MULTI-PROVIDER TRANSLATION & SUPPORT
# ============================================================================
DEEPL_API_KEY=
LIBRETRANSLATE_URL=https://libretranslate.de
VITE_SMARTSUPP_KEY=
