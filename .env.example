# Kretz Server & API Configuration

# App Port
PORT=3000
APP_PORT=3000

# Environment Mode ('development' | 'production' | 'test')
NODE_ENV=development

# Admin Log API Secrets (used to secure /api/v1/admin/logs and export endpoints)
ADMIN_LOG_API_KEY=kretz_admin_log_api_key_v1
ADMIN_LOG_API_SECRET=kretz_admin_log_secret_key_v1

# JWT Secret for Session Verification
JWT_SECRET=kretz_prime_jwt_secret_key_2026_super_secure

# Translation API Keys & Options (Optional)
DEEPL_API_KEY=
LIBRETRANSLATE_URL=https://libretranslate.de

# Live Support Chat Engine Key (Optional)
VITE_SMARTSUPP_KEY=61033062bd34d55a58c3546d5b618ead716fb2a3

# ============================================================================
# TRANSACTIONAL EMAIL PROVIDER CONFIGURATION
# ============================================================================
# Priority 1: Resend REST API (Recommended for instant delivery & webhooks)
RESEND_API_KEY=re_1234567890abcdef

# Priority 2: SendGrid Mail API v3
# SENDGRID_API_KEY=SG.1234567890abcdef

# Priority 3: SMTP Mail Relay (Zoho Mail, Gmail, Amazon SES, or Custom)
# For Zoho Mail:
#   SMTP_HOST=smtppro.zoho.com (or smtp.zoho.eu for European datacenter)
#   SMTP_PORT=465 (SSL) or 587 (TLS)
#   SMTP_USER=info@kretz.site
#   SMTP_PASS=your_zoho_app_password
#
# For Gmail / Google Workspace:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465 (SSL) or 587 (TLS)
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASS=your_16_character_app_password
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_USER=info@kretz.site
SMTP_PASS=
SMTP_FROM=info@kretz.site

# Sandbox Simulation Mode (set to 'true' to simulate delivery without sending real emails)
EMAIL_TEST_MODE=false


