# ==============================================================================
# Kretz Luxury Real Estate & Asset Tokenization Platform
# Environment Configuration Template (.env.example)
# ==============================================================================

# Server & Runtime
PORT=3000
NODE_ENV=development

# Supabase Database & Auth Integration
# (Optional: Application gracefully falls back to local double-entry ledger if unconfigured)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-edge-functions

# Cloudflare Turnstile Bot Security
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Resend / Postmark Email Provider (For Supabase Edge Functions)
RESEND_API_KEY=re_your_resend_api_key_here
