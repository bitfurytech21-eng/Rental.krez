# ==============================================================================
# L'Agence / Kretz Prime Real Estate Platform - Environment Configuration
# Copy this file to .env or configure these variables in your Cloud Run / Cloud provider
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & PLATFORM RUNTIME (Required)
# ------------------------------------------------------------------------------
# Port for the Node.js Express server.
# On Google Cloud Run or AWS, this is injected automatically (usually 8080).
PORT=8080

# Environment mode: 'production' for cloud deployment, 'development' for local
NODE_ENV=production

# Strong random secret used to sign session cookies and JWT authentication tokens.
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_secure_64_char_random_hex_string

# ------------------------------------------------------------------------------
# 2. ADMINISTRATOR ACCESS & AUTHENTICATION
# ------------------------------------------------------------------------------
# Primary administrator email address for the executive back-office
ADMIN_EMAIL=admin@kretz.com

# Administrator password (plain-text for environment injection).
# Alternatively, use ADMIN_PASSWORD_HASH for pre-hashed bcrypt strings.
ADMIN_PASSWORD=replace_with_your_secure_admin_password

# Optional: Pre-computed bcrypt hash (cost 12) if you prefer not to store plain text
# ADMIN_PASSWORD_HASH=$2a$12$...

# Secret key for automated audit log and health monitoring API access
ADMIN_LOG_API_KEY=replace_with_admin_log_secret_key

# ------------------------------------------------------------------------------
# 3. BOT PROTECTION (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
# Client-side Turnstile site key (public). Pre-configured with Cloudflare test key by default.
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAFZnc4_M_38vbkpL

# Server-side Turnstile secret key for verification
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAFZnc4_M_38vbkpL

# Set to 'true' if you want to bypass Turnstile during automated testing or staging
SKIP_TURNSTILE=false

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL & NOTIFICATIONS
# ------------------------------------------------------------------------------
# Default sender branding
EMAIL_SENDER_NAME=L'Agence · Kretz Prime
EMAIL_FROM=info@kretzdespain.com
EMAIL_REPLY_TO=support@kretzdespain.com
EMAIL_SUPPORT=info@kretzdespain.com

# Option A: Resend (Recommended cloud email provider)
# RESEND_API_KEY=re_123456789...

# Option B: SendGrid
# SENDGRID_API_KEY=SG.123456789...

# Option C: Standard SMTP (Zoho, Gmail, Google Workspace, AWS SES, Mailgun)
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_USER=info@kretzdespain.com
# SMTP_PASS=Amkelechi.2

# Set to 'true' to simulate email sending in server logs without dispatching
EMAIL_TEST_MODE=true

# ------------------------------------------------------------------------------
# 5. MULTI-ENGINE TRANSLATION API (Optional)
# ------------------------------------------------------------------------------
# DeepL API Key for neural machine translation
# DEEPL_API_KEY=your_deepl_api_key

# Optional LibreTranslate instance
# LIBRETRANSLATE_URL=https://translate.argosopentech.com/translate
# LIBRETRANSLATE_API_KEY=

# MyMemory free translation API contact email for rate-limit quota
MYMEMORY_EMAIL=info@kretzdespain.com

# ------------------------------------------------------------------------------
# 6. BLOCKCHAIN & SOLANA RPC (Optional)
# ------------------------------------------------------------------------------
# High-throughput Solana RPC provider (Helius, QuickNode, Triton, or Alchemy)
# If omitted, defaults to public Solana Mainnet-Beta RPC cluster
# SOLANA_MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=...

# ------------------------------------------------------------------------------
# 7. RELATIONAL DATABASE / PERSISTENCE (Optional)
# ------------------------------------------------------------------------------
# Cloud SQL PostgreSQL or Supabase connection URI
# DATABASE_URL=postgresql://user:password@localhost:5432/kretz_platform
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ------------------------------------------------------------------------------
# 8. LIVE CUSTOMER SUPPORT (Optional)
# ------------------------------------------------------------------------------
# Smartsupp live chat widget key
VITE_SMARTSUPP_KEY=61033062bd34d55a58c3546d5b618ead716fb2a3
